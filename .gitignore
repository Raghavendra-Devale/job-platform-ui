# .gitignore for job-platform-ui (Angular frontend)
# Node modules
node_modules/
# Build output
/dist/
# Angular cache
.angular/
# IDE/editor files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
# Environment files
.env
.env.local
.env.development
.env.test
.env.production
# Log files
*.log
# OS generated files
Thumbs.db
.DS_Store
# Temporary files
/tmp/

# Python / Virtual Environment (added to prevent accidental tracking)
.venv/
venv/
env/
__pycache__/
*.py[cod]
.python-version
uv.lock
*.py
pyproject.toml

